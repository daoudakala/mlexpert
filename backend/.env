# Fichier d'exemple pour le développement local.
# Ne jamais committer un vrai .env (secrets réels) dans git — n'y mettre
# que ce fichier .env.example, sans valeurs sensibles.

# --- Application -------------------------------------------------------
APP_NAME=MLexpert
APP_VERSION=0.1.0
ENVIRONMENT=developpement
DEBUG=true

# --- Base de données -----------------------------------------------------
# Adapte user / mot de passe / host / port / nom de base à ton installation
# PostgreSQL locale (ou celle du conteneur si tu utilises Docker).
DATABASE_URL=postgresql+psycopg2://postgres:kqlq@localhost:5432/mlexpert
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Sécurité ------------------------------------------------------------
# Clé générée aléatoirement pour le dev local uniquement (32 caractères min).
# En recette/production : générer une nouvelle clé, propre à chaque
# environnement, jamais réutilisée, jamais versionnée.
SECRET_KEY=A_A8HGlsBO7Twje5O6LfIkNqW8Cz2l0ygvjUUfrG9qHNhjkIDH3wJbYyJdoQ-JH8
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# --- CORS ------------------------------------------------------------------
# Format JSON (liste de chaînes). Origine du futur frontend Vue en dev.
CORS_ORIGINS=["http://localhost:5173"]